{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "watch": "sdk-commands start"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.8.8",
    "@dcl/sdk": "^7.8.8",
    "@types/node": "^22.15.21"
  },
  "dependencies": {
    "@dcl-sdk/utils": "^1.1.0",
    "dcl-npc-toolkit": "^1.2.2",
    "vlm-dcl": "^1.0.0-alpha.24"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
